{
  "manifest_version": 3,
  "name": "ChromeLens",
  "version": "0.1.0",
  "description": "Local-first, privacy-aware browser activity insights.",
  "permissions": ["tabs", "windows", "idle", "storage", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://127.0.0.1/*",
    "https://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ChromeLens",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "incognito": "split",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+I",
        "mac": "Alt+Shift+I"
      },
      "description": "Open ChromeLens idea capture"
    }
  }
}
